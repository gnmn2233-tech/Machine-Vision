<?xml version="1.0" ?>
<!--
  混合障碍场景 (ТЗ 4.1-3): 矮箱 + 墙 + 车辆 + 行人同时在场。
  目标点约定 (0, 8), 机器人从 (0, 0) 出发, 必须走出一条 S 形:
    y=2.0  low_box   0.8 x 0.4 x 0.10  (在 z=0.235 的单线雷达扫描面之下, 只能靠深度/卡死判定)
    y=3.6  wall      1.0 x 0.4 x 0.60  (x=1.2, 右侧封住, 走左)
    y=5.0  prius     2.1 m 长, 横置在 x=-1.5 (左侧封住, 走右)
    y=6.6  行人       站在 x=1.5 (右侧封住, 回到中线)
  行人/车辆模型与 person.sdf 同源, 用绝对 file:// 路径 (mod/ 目录名带空格, model:// 不可靠)。
-->
<sdf version='1.10'>
  <world name='default'>
    <scene>
      <ambient>0.300000012 0.300000012 0.300000012 1</ambient>
      <background>0.300000012 0.300000012 0.300000012 1</background>
      <shadows>true</shadows>
    </scene>
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <model name='ground'>
      <static>true</static>
      <link name='link'>
        <pose>0 0 -0.050000000000000003 0 0 0</pose>
        <visual name='visual'>
          <geometry>
            <box>
              <size>22 22 0.10000000000000001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
            <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <box>
              <size>22 22 0.10000000000000001</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <include>
      <uri>model://robot_with_camera</uri>
      <name>robot_with_camera</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <model name='low_box_mid'>
      <static>true</static>
      <pose>0 2.0 0.05 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.8 0.4 0.1</size></box></geometry></collision>
        <visual name='v'>
          <geometry><box><size>0.8 0.4 0.1</size></box></geometry>
          <material><ambient>0.85 0.55 0.1 1</ambient><diffuse>0.85 0.55 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name='wall_right'>
      <static>true</static>
      <pose>1.2 3.6 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>1.0 0.4 0.6</size></box></geometry></collision>
        <visual name='v'>
          <geometry><box><size>1.0 0.4 0.6</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <include>
      <uri>file:///root/gz_ros/mod/prius hybrid</uri>
      <name>car_left</name>
      <pose>1.8 5.2 0.0126 0 0 1.5707963267948963</pose>
    </include>
    <include>
      <uri>file:///root/gz_ros/mod/walking person</uri>
      <name>person_right</name>
      <pose>1.4 6.9 0.099999235505769002 0 0 0</pose>
    </include>
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.5 0.10000000000000001 -1</direction>
      <diffuse>0.899999976 0.899999976 0.899999976 1</diffuse>
      <specular>0.300000012 0.300000012 0.300000012 1</specular>
      <attenuation>
        <range>10</range>
        <linear>1</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
  </world>
</sdf>
