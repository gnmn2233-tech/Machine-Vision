<sdf version='1.10'>
  <world name='default'>
    <scene>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0.3 0.3 0.3 1</background>
      <shadows>true</shadows>
    </scene>
    <gravity>0 0 -9.8</gravity>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <model name='ground'>
      <static>true</static>
      <link name='link'>
        <pose>0 0 -0.05 0 0 0</pose>
        <visual name='visual'>
          <geometry><box><size>22 22 0.1</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
        <collision name='collision'><geometry><box><size>22 22 0.1</size></box></geometry></collision>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <include>
      <uri>model://robot_with_camera</uri>
      <name>robot_with_camera</name>
      <pose>0 2.2 0 0 0 0</pose>
    </include>
    <model name='u_back'>
      <static>true</static>
      <pose>0 3.1 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>2.4 0.2 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>2.4 0.2 0.6</size></box></geometry>
          <material><ambient>0.45 0.42 0.38 1</ambient><diffuse>0.72 0.68 0.62 1</diffuse></material></visual>
      </link>
    </model>
    <model name='u_left'>
      <static>true</static>
      <pose>-1.1 2.0 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.2 2.2 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.2 2.2 0.6</size></box></geometry>
          <material><ambient>0.45 0.42 0.38 1</ambient><diffuse>0.72 0.68 0.62 1</diffuse></material></visual>
      </link>
    </model>
    <model name='u_right'>
      <static>true</static>
      <pose>1.1 2.0 0.3 0 0 0</pose>
      <link name='link'>
        <collision name='c'><geometry><box><size>0.2 2.2 0.6</size></box></geometry></collision>
        <visual name='v'><geometry><box><size>0.2 2.2 0.6</size></box></geometry>
          <material><ambient>0.45 0.42 0.38 1</ambient><diffuse>0.72 0.68 0.62 1</diffuse></material></visual>
      </link>
    </model>
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.5 0.1 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>10</range><linear>1</linear><constant>1</constant><quadratic>0</quadratic></attenuation>
    </light>
  </world>
</sdf>
