<?xml version='1.0'?>
<sdf version='1.10'>
  <model name='robot_with_camera'>
    <link name='chassis_x'>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>9.9999999999999995e-07</ixx>
          <iyy>9.9999999999999995e-07</iyy>
          <izz>9.9999999999999995e-07</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>
      <pose>0 0 0 0 0 0</pose>
      <enable_wind>false</enable_wind>
    </link>
    <joint name='drive_x_joint' type='prismatic'>
      <parent>world</parent>
      <child>chassis_x</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-10</lower>
          <upper>10</upper>
          <effort>inf</effort>
          <velocity>inf</velocity>
          <stiffness>100000000</stiffness>
          <dissipation>1</dissipation>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>1</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
      <pose>0 0 0 0 0 0</pose>
    </joint>
    <link name='chassis_y'>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>9.9999999999999995e-07</ixx>
          <iyy>9.9999999999999995e-07</iyy>
          <izz>9.9999999999999995e-07</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>
      <pose>0 0 0 0 0 0</pose>
      <enable_wind>false</enable_wind>
    </link>
    <joint name='drive_y_joint' type='prismatic'>
      <parent>chassis_x</parent>
      <child>chassis_y</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-10</lower>
          <upper>10</upper>
          <effort>inf</effort>
          <velocity>inf</velocity>
          <stiffness>100000000</stiffness>
          <dissipation>1</dissipation>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>1</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
      <pose>0 0 0 0 0 0</pose>
    </joint>
    <link name='base'>
      <sensor name='lidar' type='gpu_lidar'>
        <pose>0 0 0.16 0 0 -1.5707963267948966</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <enable_metrics>false</enable_metrics>
        <lidar>
          <scan>
            <horizontal>
              <samples>450</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265358979</min_angle>
              <max_angle>3.14159265358979</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
              <resolution>1</resolution>
            </vertical>
          </scan>
          <range>
            <min>0.10000000000000001</min>
            <max>12</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>none</type>
            <mean>0</mean>
            <stddev>0</stddev>
          </noise>
          <visibility_mask>4294967295</visibility_mask>
        </lidar>
      </sensor>
      <pose>0 0 0.074999999999999997 0 0 1.57079732294175</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>
      <visual name='base_visual'>
        <geometry>
          <box>
            <size>0.29999999999999999 0.29999999999999999 0.14999999999999999</size>
          </box>
        </geometry>
        <material>
          <ambient>0.5 0.400000006 0.300000012 1</ambient>
          <diffuse>0.699999988 0.600000024 0.400000006 1</diffuse>
        </material>
      </visual>
      <collision name='base_collision'>
        <geometry>
          <box>
            <size>0.29999999999999999 0.29999999999999999 0.14999999999999999</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode/>
          </friction>
          <bounce/>
          <contact/>
        </surface>
      </collision>
      <enable_wind>false</enable_wind>
    </link>
    <joint name='base_yaw_joint' type='revolute'>
      <parent>chassis_y</parent>
      <child>base</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
          <effort>inf</effort>
          <velocity>inf</velocity>
          <stiffness>100000000</stiffness>
          <dissipation>1</dissipation>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>5</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
      <pose>0 0 0 0 0 0</pose>
    </joint>
    <link name='cylinder'>
      <inertial>
        <mass>0.0001</mass>
        <inertia>
          <ixx>9.9999999999999995e-07</ixx>
          <iyy>9.9999999999999995e-07</iyy>
          <izz>9.9999999999999995e-07</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>
      <visual name='cylinder_visual'>
        <geometry>
          <cylinder>
            <radius>0.080000000000000002</radius>
            <length>0.59999999999999998</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.200000003 0.5 0.800000012 1</ambient>
          <diffuse>0.300000012 0.600000024 0.899999976 1</diffuse>
        </material>
      </visual>
      <collision name='cylinder_collision'>
        <geometry>
          <cylinder>
            <radius>0.080000000000000002</radius>
            <length>0.59999999999999998</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode/>
          </friction>
          <bounce/>
          <contact/>
        </surface>
      </collision>
      <visual name='rotation_marker'>
        <pose>0.10000000000000001 0 0.28000000000000003 0 0 0</pose>
        <geometry>
          <box>
            <size>0.040000000000000001 0.040000000000000001 0.040000000000000001</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 0 1</ambient>
          <diffuse>1 1 0 1</diffuse>
        </material>
      </visual>
      <sensor name='camera' type='camera'>
        <pose>0.10000000000000001 0 0.28000000000000003 0 0 0</pose>
        <topic>/camera</topic>
        <update_rate>30</update_rate>
        <enable_metrics>false</enable_metrics>
        <camera name='__default__'>
          <pose>0 0 0 0 0 0</pose>
          <horizontal_fov>1.0469999999999999</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>RGB_INT8</format>
            <anti_aliasing>4</anti_aliasing>
          </image>
          <camera_info_topic>/camera/camera_info</camera_info_topic>
          <trigger_topic></trigger_topic>
          <triggered>false</triggered>
          <clip>
            <near>0.10000000000000001</near>
            <far>100</far>
          </clip>
          <save enabled='false'>
            <path>__default__</path>
          </save>
          <visibility_mask>4294967295</visibility_mask>
          <noise>
            <type>none</type>
            <mean>0</mean>
            <stddev>0</stddev>
          </noise>
          <distortion>
            <k1>0</k1>
            <k2>0</k2>
            <k3>0</k3>
            <p1>0</p1>
            <p2>0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <lens>
            <type>stereographic</type>
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.5707963267948966</cutoff_angle>
            <env_texture_size>256</env_texture_size>
          </lens>
          <optical_frame_id></optical_frame_id>
        </camera>
      </sensor>
      <sensor name='depth_camera' type='depth_camera'>
        <pose>0.10000000000000001 0 0.28000000000000003 0 0 0</pose>
        <topic>/depth_camera</topic>
        <update_rate>15</update_rate>
        <enable_metrics>false</enable_metrics>
        <camera name='__default__'>
          <pose>0 0 0 0 0 0</pose>
          <horizontal_fov>1.0469999999999999</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R_FLOAT32</format>
            <anti_aliasing>4</anti_aliasing>
          </image>
          <camera_info_topic>__default__</camera_info_topic>
          <trigger_topic></trigger_topic>
          <triggered>false</triggered>
          <clip>
            <near>0.10000000000000001</near>
            <far>20</far>
          </clip>
          <depth_camera>
            <output>depths</output>
            <clip>
              <near>0.10000000000000001</near>
              <far>10</far>
            </clip>
          </depth_camera>
          <save enabled='false'>
            <path>__default__</path>
          </save>
          <visibility_mask>4294967295</visibility_mask>
          <noise>
            <type>none</type>
            <mean>0</mean>
            <stddev>0</stddev>
          </noise>
          <distortion>
            <k1>0</k1>
            <k2>0</k2>
            <k3>0</k3>
            <p1>0</p1>
            <p2>0</p2>
            <center>0.5 0.5</center>
          </distortion>
          <lens>
            <type>stereographic</type>
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.5707963267948966</cutoff_angle>
            <env_texture_size>256</env_texture_size>
          </lens>
          <optical_frame_id></optical_frame_id>
        </camera>
      </sensor>
      <pose>0 0 0 0 0 0</pose>
      <enable_wind>false</enable_wind>
    </link>
    <joint name='camera_joint' type='fixed'>
      <parent>base</parent>
      <child>cylinder</child>
      <pose>0 0 0.17500000000000004 0 0 0</pose>
    </joint>
    <plugin name='gz::sim::systems::JointPositionController' filename='gz-sim-joint-position-controller-system'>
      <joint_name>base_yaw_joint</joint_name>
      <topic>camera_joint_controller/commands</topic>
      <initial_position>1.5708</initial_position>
      <p_gain>15.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>20.0</d_gain>
    </plugin>
    <plugin name='gz::sim::systems::JointStatePublisher' filename='gz-sim-joint-state-publisher-system'>
      <topic>joint_state</topic>
      <joint_name>drive_x_joint</joint_name>
      <joint_name>drive_y_joint</joint_name>
      <joint_name>base_yaw_joint</joint_name>
    </plugin>
    <plugin name='gz::sim::systems::JointPositionController' filename='gz-sim-joint-position-controller-system'>
      <joint_name>drive_x_joint</joint_name>
      <topic>drive_x/commands</topic>
      <p_gain>30.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>10.0</d_gain>
    </plugin>
    <plugin name='gz::sim::systems::JointPositionController' filename='gz-sim-joint-position-controller-system'>
      <joint_name>drive_y_joint</joint_name>
      <topic>drive_y/commands</topic>
      <p_gain>30.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>10.0</d_gain>
    </plugin>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'/>
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>
  </model>
</sdf>
